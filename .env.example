# WatchTower refuses to start in production if this is not the exact project.
GOOGLE_CLOUD_PROJECT=watchtower-507216
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
WATCHTOWER_ENV=development
WATCHTOWER_AGENT_MODEL=gemini-2.5-flash
WATCHTOWER_DETECTION_INTERVAL_SECONDS=15
WATCHTOWER_LOOKBACK_MINUTES=5
WATCHTOWER_BASELINE_MINUTES=60
WATCHTOWER_MCP_TIMEOUT_SECONDS=30
WATCHTOWER_BOOTSTRAP_SCHEMA=true

# ClickHouse Cloud uses port 8443 with TLS. For local Docker use localhost,
# port 8123, secure=false, verify=false, user=watchtower_app.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=watchtower
CLICKHOUSE_USER=watchtower_app
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=false

# A separate read-only account is used by the official mcp-clickhouse server.
CLICKHOUSE_MCP_USER=watchtower_mcp
CLICKHOUSE_MCP_PASSWORD=change-me-too

# Required for all state-changing dashboard endpoints in production.
# Store this in Secret Manager; never commit the real value.
WATCHTOWER_ADMIN_TOKEN=replace-with-a-random-secret
